{
  "name": "n8n-nodes-perform",
  "version": "0.0.1",
  "description": "n8n community node for Perform - manage trainees, plans, programs, forms, tasks and weights in your Perform fitness-coaching studio, plus a Form Filled trigger",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "perform",
    "fitness",
    "coaching",
    "crm"
  ],
  "license": "MIT",
  "author": {
    "name": "Perform",
    "email": "connect@otherwise.co.il"
  },
  "homepage": "https://github.com/otherwiseteam/n8n-nodes-perform#readme",
  "bugs": {
    "url": "https://github.com/otherwiseteam/n8n-nodes-perform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otherwiseteam/n8n-nodes-perform.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "format": "prettier nodes credentials --write",
    "test": "jest",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm run lint",
    "verify:live": "node --env-file=.env scripts/verify-live.mjs",
    "scan": "node scripts/scan.mjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PerformApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Perform/Perform.node.js",
      "dist/nodes/PerformTrigger/PerformTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.0"
  }
}
